    "SubagentStop": [{"hooks": [{"type": "command", "command": "python /absolute/observer.py --db /external/private/observations.sqlite3 hook", "timeout": 3}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "python /absolute/observer.py --db /external/private/observations.sqlite3 hook", "timeout": 3}]}],
